{
  "name": "kardo-frontend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Landing y SPA de Kardo. Estaticos puros: hablan con el backend por CORS. Aqui se compila el CSS de Tailwind y corren las pruebas de la interfaz.",
  "scripts": {
    "dev": "node dev-server.mjs",
    "css": "tailwindcss -i src/css/kardo.css -o kardo.css --minify",
    "css:watch": "tailwindcss -i src/css/kardo.css -o kardo.css --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "jsdom": "26.1.0",
    "tailwindcss": "3.4.17",
    "vitest": "5.1.1"
  }
}
