<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.13</version>
        <relativePath/>
    </parent>

    <groupId>com.kardo</groupId>
    <artifactId>kardo</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>kardo</name>
    <description>SaaS B2B de migracion de inventarios, recepcion documental con Vision IA y motor transaccional FEFO</description>

    <properties>
        <java.version>21</java.version>
        <fastexcel.version>0.20.2</fastexcel.version>
        <jjwt.version>0.12.6</jjwt.version>
        <pdfbox.version>3.0.3</pdfbox.version>
        <springdoc.version>2.6.0</springdoc.version>

        <!-- El banco de pruebas queda fuera por defecto; lo enciende -Pbench. -->
        <surefire.excluded.groups>bench</surefire.excluded.groups>
        <surefire.groups></surefire.groups>
        <bench.heap>64</bench.heap>
    </properties>

    <dependencies>
        <!-- Web MVC: controladores REST y multipart con spooling a disco -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Spring Security 6: cadena de filtros stateless con JWT Bearer -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- Actuator: health probes para el health check de Render -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Validacion de payloads (Jakarta Bean Validation) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
            Persistencia: Spring Data JDBC + JdbcTemplate.
            NO se usa spring-boot-starter-data-jpa a proposito: el Persistence Context
            de Hibernate retiene entidades en el First-Level Cache y provoca OOM
            durante la ingesta en streaming de Excel. HikariCP viene transitivo aqui.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jdbc</artifactId>
        </dependency>

        <!-- Driver PostgreSQL 15 (Supabase) -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
            PDFBox para el informe valorizado imprimible.
            Se elige frente a OpenPDF por la licencia: Apache-2.0 frente a LGPL,
            que en un producto comercial es una pregunta que conviene no tener.
            A cambio hay que componer la tabla a mano, lo que de paso permite
            controlar la memoria pagina a pagina.
        -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>${pdfbox.version}</version>
        </dependency>

        <!-- fastexcel (dhatim): lectura/escritura XLSX en streaming, memoria constante -->
        <dependency>
            <groupId>org.dhatim</groupId>
            <artifactId>fastexcel-reader</artifactId>
            <version>${fastexcel.version}</version>
        </dependency>
        <dependency>
            <groupId>org.dhatim</groupId>
            <artifactId>fastexcel</artifactId>
            <version>${fastexcel.version}</version>
        </dependency>

        <!-- JJWT: firma y verificacion HS256 de los access tokens -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Metadatos de @ConfigurationProperties para el IDE -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            Pruebas de integracion sobre un PostgreSQL efimero.
            El SQL es donde vive la logica critica de Kardo (FEFO, mermas,
            invariante de masa, matching con GIN); hasta ahora solo se verificaba
            a mano. Testcontainers levanta la misma version que sirve Supabase y
            ejecuta los scripts de sql/ en cada build.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            Contrato de la API navegable. No es documentacion que alguien tenga
            que mantener al dia: sale de los propios controladores y de las
            anotaciones de validacion, asi que si el codigo cambia y la pagina
            no, es que no cambio nada.
        -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <!-- Guarda extra: la configuracion local vive en ./config y jamas
                     debe viajar dentro del jar desplegado en Render. -->
                <excludes>
                    <exclude>application-local.properties</exclude>
                </excludes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!--
                El banco de pruebas de la ingesta mide un entorno, no una regla:
                en una maquina cargada da otro numero sin que el codigo cambie.
                Queda fuera del build y se pide a proposito con `mvn test -Pbench`.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <excludedGroups>${surefire.excluded.groups}</excludedGroups>
                    <groups>${surefire.groups}</groups>
                </configuration>
            </plugin>

            <!--
                Las pruebas de integracion (*IT) corren en la fase verify, no en
                test: necesitan Docker para levantar PostgreSQL. Donde no lo hay
                se saltan solas (ver DockerAvailable), de modo que `mvn verify`
                sigue siendo verde en una maquina sin Docker y completo en CI.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Solo el banco de pruebas, con el numero de filas que se le pida:
             mvn test -Pbench [-Dbench.rows=100000] -->
        <profile>
            <id>bench</id>
            <properties>
                <surefire.excluded.groups></surefire.excluded.groups>
                <surefire.groups>bench</surefire.groups>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <!-- El limite ES la prueba: con 64 MB no cabe un
                                 archivo de decenas de miles de filas, asi que
                                 si la ingesta no fuera en streaming, aqui
                                 reventaria con OutOfMemoryError. -->
                            <argLine>-Xmx${bench.heap}m</argLine>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
