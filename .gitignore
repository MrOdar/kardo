# .gitignore para SmartKardex AI

# Archivos de compilación Java / Maven
target/
*.class
*.jar
*.war
*.ear

# Logs
logs/
*.log

# IDEs
.idea/
*.iml
.vscode/
.classpath
.project
.settings/
.claude/

# Archivos de configuración local y secretos (NUNCA subir a Git)
application-local.properties
.env
*.env.local

# Archivos temporales de Tomcat
/tmp/
*.tmp

# Maven wrapper (se usa la instalacion local de Maven)
.mvn/wrapper/maven-wrapper.jar

# Fotos de guias de remision reales: son datos de negocio del cliente
samples/

# Las pruebas de la SPA usan Node, pero el proyecto no lo necesita para
# construirse: app.js e index.html se sirven tal cual desde el jar. Render no
# instala Node y no tiene por que.
node_modules/
